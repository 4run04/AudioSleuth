{
  "version": 1,
  "chunks": [
    {
      "chunk_id": "bf94c59f951d-0000",
      "speaker_id": "SPEAKER_00",
      "start_ms": 360,
      "end_ms": 9110,
      "start_sec": 0.36,
      "end_sec": 9.11,
      "transcript": "Welcome to Market Signals. Today we are discussing interest rates, startup valuation, and renewable energy.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0000.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0001",
      "speaker_id": "SPEAKER_00",
      "start_ms": 9110,
      "end_ms": 14825,
      "start_sec": 9.11,
      "end_sec": 14.825,
      "transcript": "I want to begin with a calm explanation of why central banks care about inflation.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0001.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0002",
      "speaker_id": "SPEAKER_01",
      "start_ms": 15545,
      "end_ms": 26420,
      "start_sec": 15.545,
      "end_sec": 26.42,
      "transcript": "I completely disagree about interest rates! Raising borrowing costs again would punish small businesses. That is a terrible decision! Inflation is already falling, and this argument ignores ordinary families paying their mortgages.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0002.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0003",
      "speaker_id": "SPEAKER_00",
      "start_ms": 27190,
      "end_ms": 38550,
      "start_sec": 27.19,
      "end_sec": 38.55,
      "transcript": "Let us slow down and examine the evidence. Lower interest rates can encourage investment, but cutting too quickly may increase inflation.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0003.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0004",
      "speaker_id": "SPEAKER_00",
      "start_ms": 38550,
      "end_ms": 44865,
      "start_sec": 38.55,
      "end_sec": 44.865,
      "transcript": "My position is to keep monetary policy steady while we review the employment data.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0004.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0005",
      "speaker_id": "SPEAKER_01",
      "start_ms": 45595,
      "end_ms": 53830,
      "start_sec": 45.595,
      "end_sec": 53.83,
      "transcript": "Ha ha ha! Their startup valuation is absolutely hilarious. They have three customers and a coffee machine, yet they want a billion dollars.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0005.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0006",
      "speaker_id": "SPEAKER_01",
      "start_ms": 53830,
      "end_ms": 58850,
      "start_sec": 53.83,
      "end_sec": 58.85,
      "transcript": "I cannot stop laughing about that valuation! A spreadsheet does not create a business.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0006.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0007",
      "speaker_id": "SPEAKER_00",
      "start_ms": 59600,
      "end_ms": 69435,
      "start_sec": 59.6,
      "end_sec": 69.435,
      "transcript": "A serious valuation starts with cash flow, revenue growth, and customer retention. Investors should compare the company with similar businesses.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0007.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0008",
      "speaker_id": "SPEAKER_00",
      "start_ms": 69435,
      "end_ms": 74700,
      "start_sec": 69.435,
      "end_sec": 74.7,
      "transcript": "The discount rate matters because future earnings are worth less than cash received today.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0008.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0009",
      "speaker_id": "SPEAKER_01",
      "start_ms": 75434,
      "end_ms": 88065,
      "start_sec": 75.434,
      "end_sec": 88.065,
      "transcript": "Now for some exciting news about renewable energy. Improved battery storage can hold solar power after sunset. Wind farms and a stronger electricity grid could reduce costs while making the energy supply more reliable.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0009.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0010",
      "speaker_id": "SPEAKER_00",
      "start_ms": 88825,
      "end_ms": 106970,
      "start_sec": 88.825,
      "end_sec": 106.97,
      "transcript": "There is also a quiet concern about privacy. Voice recordings can reveal personal information. A responsible audio search system should preserve the source timestamps, explain its confidence, and avoid claiming that a guess is a verified fact.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0010.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0011",
      "speaker_id": "SPEAKER_01",
      "start_ms": 107720,
      "end_ms": 117560,
      "start_sec": 107.72,
      "end_sec": 117.56,
      "transcript": "That is a useful place to finish. We disagreed about interest rates, laughed about valuation, and found common ground on clean energy.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
      "audio_path": "bf94c59f951d-0011.wav",
      "source_sha256": "bf94c59f951de7b907e90f8028ab3028a76f5073c3002c988392cc55787060f1"
    },
    {
      "chunk_id": "bf94c59f951d-0012",
      "speaker_id": "SPEAKER_01",
      "start_ms": 117560,
      "end_ms": 125405,
      "start_sec": 117.56,
      "end_sec": 125.405,
      "transcript": "Thanks for listening to Market Signals. This conversation was created specifically for the Audio Sleuth demonstration.",
      "confidence": 1.0,
      "speaker_confidence": 1.0,
      "timing": "synthetic",
